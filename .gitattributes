* text=auto eol=lf

# Runtime state and archived files are not part of source normalization.
archive/** -text
data/** -text
.codex-run/** -text
config.json -text

# Preserve the five imported design files byte-for-byte, including on Windows.
frontend/src/design/JavJaeger.dc.html -text
frontend/src/design/support.js -text
frontend/src/design/_ds/** -text
frontend/src/design/static/logo.jpg binary
# esbuild embeds the unchanged template text, including its original whitespace.
static/app.js -text whitespace=-blank-at-eol
static/app.css -text
